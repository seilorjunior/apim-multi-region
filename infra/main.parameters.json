{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "aksAdminGroupObjectId": { "value": "${AKS_ADMIN_GROUP_OBJECT_ID}" },
    "publisherName": { "value": "${APIM_PUBLISHER_NAME}" },
    "publisherEmail": { "value": "${APIM_PUBLISHER_EMAIL}" },
    "brazilLocation": { "value": "${BRAZIL_LOCATION}" },
    "usLocation": { "value": "${US_LOCATION}" },
    "brazilApimPublicAccess": { "value": "${APIM_PUBLIC_ACCESS_BR}" },
    "usApimPublicAccess": { "value": "${APIM_PUBLIC_ACCESS_US}" },
    "deploymentProfile": { "value": "${DEPLOYMENT_PROFILE}" },
    "monitoringMode": { "value": "${MONITORING_MODE}" },
    "alertsMode": { "value": "${ALERTS_MODE}" },
    "region1Zones": { "value": "${REGION1_ZONES}" },
    "region2Zones": { "value": "${REGION2_ZONES}" },
    "alertActionGroupId": { "value": "${ALERT_ACTION_GROUP_ID}" }
  }
}
